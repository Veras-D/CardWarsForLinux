func _ready() -> void:
	if fionna_icon:
		fionna_icon.transform = Transform3D(
			Vector3(0.0, 0.0, -0.08483),
			Vector3(0.08483, 0.0, 0.0),
			Vector3(0.0, -0.08483, 0.0),
			Vector3(0.0, 0.022, -0.211)
		)
	if dummy_book:
		dummy_book.scale = Vector3(0.5894142, 0.5894142, 0.5894142)
	if book_spine:
		book_spine.position = Vector3(0.0, 0.0, -0.0000001)
		book_spine.scale = Vector3(0.2936102, 0.2936102, 0.7617162)
		book_spine.quaternion = Quaternion.IDENTITY
	if book_end:
		book_end.position = Vector3(0.0, 0.0, -0.0000001)
		book_end.scale = Vector3(0.2936102, 0.2936102, 0.7617162)
		book_end.quaternion = Quaternion.IDENTITY
	if book_page3:
		book_page3.position = Vector3(0.0, 0.0, -0.4527779)
		book_page3.scale = Vector3(0.2936102, 0.2936102, 0.7617162)
	if book_page2:
		book_page2.position = Vector3(0.0, 0.00000006, -0.5684313)
		book_page2.scale = Vector3(0.2936102, 0.2936102, 0.4689945)
	if book_page1:
		book_page1.position = Vector3(0.0, 0.00000006, -0.6676478)
		book_page1.scale = Vector3(0.2936102, 0.2936102, 0.4689945)
	if book_cover:
		book_cover.position = Vector3(0.0, 0.0, -0.7823124)
		book_cover.scale = Vector3(0.2936102, 0.2936102, 0.7617162)
	reset_anim()

func reset_anim() -> void:
	is_activating = false
	anim_time = 0.0
	_apply_idle_frame(0.0)

func open_book(_duration: float = 0.55) -> void:
	# Kept for backwards compatibility; Idle_2.anim plays automatically
	reset_anim()

func close_book(_duration: float = 0.22) -> void:
	reset_anim()

func play_activate() -> void:
	is_activating = true
	anim_time = 0.0
	_apply_activate_frame(0.0)

func _process(delta: float) -> void:
	if is_activating:
		anim_time += delta
		if anim_time >= ACTIVATE_DURATION:
			is_activating = false
			anim_time = 0.0
			_apply_idle_frame(0.0)
			activate_finished.emit()
		else:
			_apply_activate_frame(anim_time)
	else:
		anim_time = fmod(anim_time + delta, IDLE_DURATION)
		_apply_idle_frame(anim_time)

func _apply_idle_frame(t: float) -> void:
	if dummy_book:
		dummy_book.position = _eval_v3(IDLE_POS_DUMMY, t)
		dummy_book.quaternion = _eval_quat(IDLE_ROT_DUMMY, t)
	if book_cover:
		book_cover.quaternion = _eval_quat(IDLE_ROT_COVER, t)
	if book_page1:
		book_page1.quaternion = _eval_quat(IDLE_ROT_PAGE1, t)
	if book_page2:
		book_page2.quaternion = _eval_quat(IDLE_ROT_PAGE2, t)
	if book_page3:
		book_page3.quaternion = _eval_quat(IDLE_ROT_PAGE3, t)

func _apply_activate_frame(t: float) -> void:
	if dummy_book:
		dummy_book.position = _eval_v3(ACT_POS_DUMMY, t)
		dummy_book.quaternion = _eval_quat(ACT_ROT_DUMMY, t)
	if book_cover:
		book_cover.quaternion = _eval_quat(ACT_ROT_COVER, t)
	if book_page1:
		book_page1.quaternion = _eval_quat(ACT_ROT_PAGE1, t)
	if book_page2:
		book_page2.quaternion = _eval_quat(ACT_ROT_PAGE2, t)
	if book_page3:
		book_page3.quaternion = _eval_quat(ACT_ROT_PAGE3, t)

static func _find_seg(keys: Array, t: float) -> int:
	var n: int = keys.size()
	if t <= keys[0][0]:
		return 0
	if t >= keys[n - 1][0]:
		return n - 2
	var lo: int = 0
	var hi: int = n - 1
	while lo + 1 < hi:
		var mid: int = (lo + hi) >> 1
		if keys[mid][0] <= t:
			lo = mid
		else:
			hi = mid
	return lo

static func _eval_v3(keys: Array, t: float) -> Vector3:
	var i: int = _find_seg(keys, t)
	var k0: Array = keys[i]
	var k1: Array = keys[i + 1]
	var dt: float = k1[0] - k0[0]
	if dt <= 0.000001:
		return k0[1]
	var u: float = clampf((t - k0[0]) / dt, 0.0, 1.0)
	var u2: float = u * u
	var u3: float = u2 * u
	var h00: float = 2.0 * u3 - 3.0 * u2 + 1.0
	var h10: float = u3 - 2.0 * u2 + u
	var h01: float = -2.0 * u3 + 3.0 * u2
	var h11: float = u3 - u2
	var v0: Vector3 = k0[1]
	var v1: Vector3 = k1[1]
	var out0: Vector3 = k0[3]
	var in1: Vector3 = k1[2]
	return v0 * h00 + out0 * (h10 * dt) + v1 * h01 + in1 * (h11 * dt)

static func _eval_quat(keys: Array, t: float) -> Quaternion:
	var i: int = _find_seg(keys, t)
	var k0: Array = keys[i]
	var k1: Array = keys[i + 1]
	var dt: float = k1[0] - k0[0]
	if dt <= 0.000001:
		var q_init: Vector4 = k0[1]
		return Quaternion(q_init.x, q_init.y, q_init.z, q_init.w).normalized()
	var u: float = clampf((t - k0[0]) / dt, 0.0, 1.0)
	var u2: float = u * u
	var u3: float = u2 * u
	var h00: float = 2.0 * u3 - 3.0 * u2 + 1.0
	var h10: float = u3 - 2.0 * u2 + u
	var h01: float = -2.0 * u3 + 3.0 * u2
	var h11: float = u3 - u2
	var v0: Vector4 = k0[1]
	var v1: Vector4 = k1[1]
	var out0: Vector4 = k0[3]
	var in1: Vector4 = k1[2]
	var r: Vector4 = v0 * h00 + out0 * (h10 * dt) + v1 * h01 + in1 * (h11 * dt)
	return Quaternion(r.x, r.y, r.z, r.w).normalized()
