static func _eval_quat(keys: Array, t: float) -> Quaternion:
	if t <= keys[0][0]:
		var v0: Vector4 = keys[0][1]
		return Quaternion(v0.x, v0.y, v0.z, v0.w).normalized()
	var last_idx := keys.size() - 1
	if t >= keys[last_idx][0]:
		var vl: Vector4 = keys[last_idx][1]
		return Quaternion(vl.x, vl.y, vl.z, vl.w).normalized()
	for i in range(last_idx):
		var t0: float = keys[i][0]
		var t1: float = keys[i + 1][0]
		if t >= t0 and t <= t1:
			var dt := t1 - t0
			if dt <= 0.000001:
				var vc: Vector4 = keys[i][1]
				return Quaternion(vc.x, vc.y, vc.z, vc.w).normalized()
			var u := (t - t0) / dt
			var u2 := u * u
			var u3 := u2 * u
			var h00 := 2.0 * u3 - 3.0 * u2 + 1.0
			var h10 := u3 - 2.0 * u2 + u
			var h01 := -2.0 * u3 + 3.0 * u2
			var h11 := u3 - u2
			var p0: Vector4 = keys[i][1]
			var m0: Vector4 = keys[i][3] * dt
			var p1: Vector4 = keys[i + 1][1]
			var m1: Vector4 = keys[i + 1][2] * dt
			var r := p0 * h00 + m0 * h10 + p1 * h01 + m1 * h11
			return Quaternion(r.x, r.y, r.z, r.w).normalized()
	var vf: Vector4 = keys[0][1]
	return Quaternion(vf.x, vf.y, vf.z, vf.w).normalized()


static func _eval_vec3(keys: Array, t: float) -> Vector3:
	if t <= keys[0][0]:
		return keys[0][1]
	var last_idx := keys.size() - 1
	if t >= keys[last_idx][0]:
		return keys[last_idx][1]
	for i in range(last_idx):
		var t0: float = keys[i][0]
		var t1: float = keys[i + 1][0]
		if t >= t0 and t <= t1:
			var dt := t1 - t0
			if dt <= 0.000001:
				return keys[i][1]
			var u := (t - t0) / dt
			var u2 := u * u
			var u3 := u2 * u
			var h00 := 2.0 * u3 - 3.0 * u2 + 1.0
			var h10 := u3 - 2.0 * u2 + u
			var h01 := -2.0 * u3 + 3.0 * u2
			var h11 := u3 - u2
			var p0: Vector3 = keys[i][1]
			var m0: Vector3 = keys[i][3] * dt
			var p1: Vector3 = keys[i + 1][1]
			var m1: Vector3 = keys[i + 1][2] * dt
			return p0 * h00 + m0 * h10 + p1 * h01 + m1 * h11
	return keys[0][1]



func reset_anim() -> void:
	_playing_intro = true
	anim_time = 0.0
	_apply_intro_frame(0.0)

func _ready() -> void:
	_apply_idle_frame(0.0)

func _process(delta: float) -> void:
	var vis := is_visible_in_tree()
	if not _was_visible and vis:
		reset_anim()
	_was_visible = vis
	if not vis:
		return
	anim_time += delta
	if _playing_intro:
		if anim_time >= INTRO_DURATION:
			_playing_intro = false
			anim_time = fmod(anim_time - INTRO_DURATION, IDLE_DURATION)
			_apply_idle_frame(anim_time)
		else:
			_apply_intro_frame(anim_time)
	else:
		anim_time = fmod(anim_time, IDLE_DURATION)
		_apply_idle_frame(anim_time)

func _apply_intro_frame(t: float) -> void:
	if base:
		base.position = _eval_vec3(INTRO_POS_PUPPET_BASE, t)
		base.scale = _eval_vec3(INTRO_SCALE_PUPPET_BASE, t)
	if gem01:
		gem01.position = _eval_vec3(INTRO_POS_PUPPET_GEM01, t)
		gem01.quaternion = _eval_quat(INTRO_ROT_PUPPET_GEM01, t)
		gem01.scale = _eval_vec3(INTRO_SCALE_PUPPET_GEM01, t)
	if gem02:
		gem02.position = _eval_vec3(INTRO_POS_PUPPET_GEM02, t)
		gem02.quaternion = _eval_quat(INTRO_ROT_PUPPET_GEM02, t)
		gem02.scale = _eval_vec3(INTRO_SCALE_PUPPET_GEM02, t)
	if gem03:
		gem03.position = _eval_vec3(INTRO_POS_PUPPET_GEM03, t)
		gem03.quaternion = _eval_quat(INTRO_ROT_PUPPET_GEM03, t)
		gem03.scale = _eval_vec3(INTRO_SCALE_PUPPET_GEM03, t)
	if twinkle01:
		twinkle01.scale = _eval_vec3(INTRO_SCALE_PUPPET_TWINKLE01, t)
	if twinkle02:
		twinkle02.scale = Vector3(0.001, 0.001, 0.001)

func _apply_idle_frame(t: float) -> void:
	if base:
		base.position = IDLE_REST_BASE_POS
		base.scale = Vector3.ONE
	if gem01:
		gem01.position = IDLE_REST_GEM01_POS
		gem01.quaternion = IDLE_REST_GEM01_ROT.normalized()
		gem01.scale = Vector3.ONE
	if gem02:
		gem02.position = IDLE_REST_GEM02_POS
		gem02.quaternion = IDLE_REST_GEM02_ROT.normalized()
		gem02.scale = Vector3.ONE
	if gem03:
		gem03.position = IDLE_REST_GEM03_POS
		gem03.quaternion = IDLE_REST_GEM03_ROT.normalized()
		gem03.scale = Vector3.ONE
	if twinkle01:
		twinkle01.position = _eval_vec3(IDLE_POS_PUPPET_TWINKLE01, t)
		twinkle01.scale = _eval_vec3(IDLE_SCALE_PUPPET_TWINKLE01, t)
	if twinkle02:
		twinkle02.position = IDLE_REST_TWINKLE02_POS
		twinkle02.scale = _eval_vec3(IDLE_SCALE_PUPPET_TWINKLE02, t)
