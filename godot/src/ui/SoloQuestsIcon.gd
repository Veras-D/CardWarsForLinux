@onready var all_cards: Node3D = $SinglePlayerRoot/PuppetGlobal/PuppetGlobalAllCards
@onready var deck01: MeshInstance3D = $SinglePlayerRoot/PuppetGlobal/PuppetGlobalAllCards/Deck01
@onready var deck02: MeshInstance3D = $SinglePlayerRoot/PuppetGlobal/PuppetGlobalAllCards/Deck02
@onready var card01: MeshInstance3D = $SinglePlayerRoot/PuppetGlobal/PuppetGlobalAllCards/Card01
@onready var card02: MeshInstance3D = $SinglePlayerRoot/PuppetGlobal/PuppetGlobalAllCards/Card02
@onready var card03: MeshInstance3D = $SinglePlayerRoot/PuppetGlobal/PuppetGlobalAllCards/Card03
@onready var card04: MeshInstance3D = $SinglePlayerRoot/PuppetGlobal/PuppetGlobalAllCards/Card04
@onready var card05: MeshInstance3D = $SinglePlayerRoot/PuppetGlobal/PuppetGlobalAllCards/Card05
@onready var knife: MeshInstance3D = $SinglePlayerRoot/PuppetGlobal/PuppetKnife

var anim_time: float = 0.0
var is_activating: bool = false
var _shuffle_played_this_loop: bool = false
var _dagger_played: bool = false
var _was_visible: bool = false
var _sfx_player: AudioStreamPlayer = null

func _ready() -> void:
	_sfx_player = AudioStreamPlayer.new()
	_sfx_player.name = "QuestsSFXPlayer"
	_sfx_player.bus = "SFX" if AudioServer.get_bus_index("SFX") != -1 else "Master"
	add_child(_sfx_player)
	reset_anim()

func reset_anim() -> void:
	is_activating = false
	anim_time = 0.0
	_shuffle_played_this_loop = false
	_dagger_played = false
	_apply_idle_frame(0.0)

func stop_audio() -> void:
	if _sfx_player and _sfx_player.playing:
		_sfx_player.stop()

func play_activate() -> void:
	is_activating = true
	anim_time = 0.0
	_dagger_played = false
	stop_audio()
	_apply_activate_frame(0.0)

func _play_clip(stream: AudioStream) -> void:
	if _sfx_player and stream:
		_sfx_player.bus = "SFX" if AudioServer.get_bus_index("SFX") != -1 else "Master"
		_sfx_player.stream = stream
		_sfx_player.play()

func _process(delta: float) -> void:
	var vis := is_visible_in_tree()
	if _was_visible and not vis:
		stop_audio()
	elif not _was_visible and vis and not is_activating:
		anim_time = 0.0
		_shuffle_played_this_loop = false
	_was_visible = vis

	if not vis:
		return

	if is_activating:
		anim_time += delta
		if not _dagger_played and anim_time >= 0.1:
			_dagger_played = true
			_play_clip(SFX_MAP_DAGGER)
		if anim_time >= ACT_DURATION:
			is_activating = false
			anim_time = 0.0
			_shuffle_played_this_loop = true
			_apply_idle_frame(0.0)
			activate_finished.emit()
		else:
			_apply_activate_frame(anim_time)
	else:
		if not _shuffle_played_this_loop:
			_shuffle_played_this_loop = true
			_play_clip(SFX_CARDS_SHUFFLE)
		var next_t := anim_time + delta
		if next_t >= IDLE_DURATION:
			next_t = fmod(next_t, IDLE_DURATION)
			_shuffle_played_this_loop = true
			_play_clip(SFX_CARDS_SHUFFLE)
		anim_time = next_t
		_apply_idle_frame(anim_time)

func _apply_idle_frame(t: float) -> void:
	if all_cards:
		all_cards.position = _eval_vec3(IDLE_POS_PUPPET_GLOBALALLCARDS, t)
		all_cards.quaternion = _eval_quat(IDLE_ROT_PUPPET_GLOBALALLCARDS, t)
	if deck01:
		deck01.position = _eval_vec3(IDLE_POS_PUPPET_DECK01, t)
		deck01.quaternion = _eval_quat(IDLE_ROT_PUPPET_DECK01, t)
		deck01.scale = _eval_vec3(IDLE_SCALE_PUPPET_DECK01, t)
	if deck02:
		deck02.position = _eval_vec3(IDLE_POS_PUPPET_DECK02, t)
		deck02.quaternion = _eval_quat(IDLE_ROT_PUPPET_DECK02, t)
		deck02.scale = _eval_vec3(IDLE_SCALE_PUPPET_DECK02, t)
	if card01:
		card01.position = _eval_vec3(IDLE_POS_PUPPET_CARD01, t)
		card01.quaternion = _eval_quat(IDLE_ROT_PUPPET_CARD01, t)
		card01.scale = _eval_vec3(IDLE_SCALE_PUPPET_CARD01, t)
	if card02:
		card02.position = _eval_vec3(IDLE_POS_PUPPET_CARD02, t)
		card02.quaternion = _eval_quat(IDLE_ROT_PUPPET_CARD02, t)
		card02.scale = _eval_vec3(IDLE_SCALE_PUPPET_CARD02, t)
	if card03:
		card03.position = _eval_vec3(IDLE_POS_PUPPET_CARD03, t)
		card03.quaternion = _eval_quat(IDLE_ROT_PUPPET_CARD03, t)
		card03.scale = _eval_vec3(IDLE_SCALE_PUPPET_CARD03, t)
	if card04:
		card04.position = _eval_vec3(IDLE_POS_PUPPET_CARD04, t)
		card04.quaternion = _eval_quat(IDLE_ROT_PUPPET_CARD04, t)
		card04.scale = _eval_vec3(IDLE_SCALE_PUPPET_CARD04, t)
	if card05:
		card05.position = _eval_vec3(IDLE_POS_PUPPET_CARD05, t)
		card05.quaternion = _eval_quat(IDLE_ROT_PUPPET_CARD05, t)
		card05.scale = _eval_vec3(IDLE_SCALE_PUPPET_CARD05, t)
	if knife:
		knife.visible = false
		knife.position = Vector3(-65.8119, 3.0783, 3.3303)
		knife.quaternion = Quaternion.IDENTITY
		knife.scale = Vector3(0.01, 0.01, 0.01)

func _apply_activate_frame(t: float) -> void:
	if all_cards:
		all_cards.position = _eval_vec3(ACT_POS_PUPPET_GLOBALALLCARDS, t)
		all_cards.quaternion = _eval_quat(ACT_ROT_PUPPET_GLOBALALLCARDS, t)
	if deck01:
		deck01.position = _eval_vec3(ACT_POS_PUPPET_DECK01, t)
		deck01.quaternion = Quaternion.IDENTITY
		deck01.scale = Vector3.ONE
	if deck02:
		deck02.position = _eval_vec3(ACT_POS_PUPPET_DECK02, t)
		deck02.quaternion = _eval_quat(ACT_ROT_PUPPET_DECK02, t)
		deck02.scale = Vector3.ONE
	if card01:
		card01.position = _eval_vec3(ACT_POS_PUPPET_CARD01, t)
		card01.quaternion = _eval_quat(ACT_ROT_PUPPET_CARD01, t)
		card01.scale = _eval_vec3(ACT_SCALE_PUPPET_CARD01, t)
	if card02:
		card02.position = _eval_vec3(ACT_POS_PUPPET_CARD02, t)
		card02.quaternion = _eval_quat(ACT_ROT_PUPPET_CARD02, t)
		card02.scale = _eval_vec3(ACT_SCALE_PUPPET_CARD02, t)
	if card03:
		card03.position = _eval_vec3(ACT_POS_PUPPET_CARD03, t)
		card03.quaternion = Quaternion.IDENTITY
		card03.scale = Vector3(0.001, 0.001, 0.001)
	if card04:
		card04.position = _eval_vec3(ACT_POS_PUPPET_CARD04, t)
		card04.quaternion = Quaternion.IDENTITY
		card04.scale = Vector3(0.01, 0.01, 0.01)
	if card05:
		card05.position = _eval_vec3(ACT_POS_PUPPET_CARD05, t)
		card05.quaternion = Quaternion.IDENTITY
		card05.scale = Vector3(0.001, 0.001, 0.001)
	if knife:
		knife.visible = true
		knife.position = _eval_vec3(ACT_POS_PUPPET_KNIFE, t)
		knife.quaternion = _eval_quat(ACT_ROT_PUPPET_KNIFE, t)
		knife.scale = _eval_vec3(ACT_SCALE_PUPPET_KNIFE, t)

static func _find_seg(keys: Array, t: float) -> int:
	var n: int = keys.size()
	if t <= keys[0][0]:
		return 0
	if t >= keys[n - 1][0]:
		return n - 2
	var lo: int = 0
	var hi: int = n - 1
	while lo + 1 < hi:
		var mid: int = (lo + hi) >> 1
		if keys[mid][0] <= t:
			lo = mid
		else:
			hi = mid
	return lo

static func _eval_vec3(keys: Array, t: float) -> Vector3:
	var i: int = _find_seg(keys, t)
	var k0: Array = keys[i]
	var k1: Array = keys[i + 1]
	var dt: float = k1[0] - k0[0]
	if dt <= 0.000001:
		return k0[1]
	var u: float = clampf((t - k0[0]) / dt, 0.0, 1.0)
	var u2: float = u * u
	var u3: float = u2 * u
	var h00: float = 2.0 * u3 - 3.0 * u2 + 1.0
	var h10: float = u3 - 2.0 * u2 + u
	var h01: float = -2.0 * u3 + 3.0 * u2
	var h11: float = u3 - u2
	var p0: Vector3 = k0[1]
	var m0: Vector3 = k0[3] * dt
	var p1: Vector3 = k1[1]
	var m1: Vector3 = k1[2] * dt
	return p0 * h00 + m0 * h10 + p1 * h01 + m1 * h11

static func _eval_quat(keys: Array, t: float) -> Quaternion:
	var i: int = _find_seg(keys, t)
	var k0: Array = keys[i]
	var k1: Array = keys[i + 1]
	var dt: float = k1[0] - k0[0]
	if dt <= 0.000001:
		var v0: Vector4 = keys[i][1]
		return Quaternion(v0.x, v0.y, v0.z, v0.w).normalized()
	var u: float = clampf((t - k0[0]) / dt, 0.0, 1.0)
	var u2: float = u * u
	var u3: float = u2 * u
	var h00: float = 2.0 * u3 - 3.0 * u2 + 1.0
	var h10: float = u3 - 2.0 * u2 + u
	var h01: float = -2.0 * u3 + 3.0 * u2
	var h11: float = u3 - u2
	var p0: Vector4 = k0[1]
	var m0: Vector4 = k0[3] * dt
	var p1: Vector4 = k1[1]
	var m1: Vector4 = k1[2] * dt
	var r: Vector4 = p0 * h00 + m0 * h10 + p1 * h01 + m1 * h11
	return Quaternion(r.x, r.y, r.z, r.w).normalized()
