albedo_color = Color(1.18, 1.18, 1.18, 1)
albedo_texture = ExtResource("2_tmulti")
texture_filter = 3

[sub_resource type="Shader" id="Shader_Flags"]
code = "shader_type spatial;
render_mode unshaded, cull_disabled;

uniform sampler2D albedo_tex : source_color, filter_linear_mipmap;
uniform float flags01_dx = 0.0;
uniform float flags02_dx = 0.0;

void vertex() {
	float uz = -VERTEX.z;
	if (uz < 4.8) {
		VERTEX.x += flags02_dx;
	} else if (uz < 5.9) {
		VERTEX.x += flags01_dx;
	}
}

void fragment() {
	ALBEDO = texture(albedo_tex, UV).rgb * 1.18;
}
"

[sub_resource type="ShaderMaterial" id="Mat_Flags"]
render_priority = 0
shader = SubResource("Shader_Flags")
shader_parameter/albedo_tex = ExtResource("2_tmulti")
