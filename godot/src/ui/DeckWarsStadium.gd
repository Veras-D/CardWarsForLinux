func _ready() -> void:
	if puppet_global:
		puppet_global.transform = Transform3D(
			Vector3(0.0, 0.0, -0.04),
			Vector3(0.034641, -0.02, 0.0),
			Vector3(-0.02, -0.034641, 0.0),
			Vector3.ZERO
		)
	if puppet_spot01:
		puppet_spot01.position = Vector3(8.869195, -7.475797, -0.7031903)
		puppet_spot01.scale = Vector3(1.0, 1.3, 1.3)
	if puppet_spot02:
		puppet_spot02.position = Vector3(-9.272536, -7.611367, -0.6587886)
		puppet_spot02.scale = Vector3(1.0, 1.3, 1.3)
	if puppet_bling01:
		puppet_bling01.quaternion = Quaternion(0.0, 0.0, 0.8886173, -0.4586496)
	if puppet_bling02:
		puppet_bling02.quaternion = Quaternion(0.0, 0.0, -0.4648421, 0.8853936)
	if flags_mesh:
		flags_mat = flags_mesh.get_surface_override_material(0) as ShaderMaterial
	_apply_frame(0.0)

func reset_anim() -> void:
	anim_time = 0.0
	_apply_frame(0.0)

func _process(delta: float) -> void:
	anim_time = fmod(anim_time + delta, DURATION)
	_apply_frame(anim_time)

func _apply_frame(t: float) -> void:
	if puppet_stadium:
		var sc_s: float = _eval_1d(SCALE_STADIUM, t)
		puppet_stadium.scale = Vector3(sc_s, sc_s, sc_s)
	if puppet_bling01:
		puppet_bling01.position = _eval_v3(POS_BLING01, t)
		var sc_b1: float = maxf(0.001, _eval_1d(SCALE_BLING01, t))
		puppet_bling01.scale = Vector3(sc_b1, sc_b1, sc_b1)
	if puppet_bling02:
		puppet_bling02.position = _eval_v3(POS_BLING02, t)
		var sc_b2: float = maxf(0.001, _eval_1d(SCALE_BLING02, t))
		puppet_bling02.scale = Vector3(sc_b2, sc_b2, sc_b2)
	if puppet_spot01:
		puppet_spot01.quaternion = _eval_quat(ROT_SPOT01, t)
	if puppet_spot02:
		puppet_spot02.quaternion = _eval_quat(ROT_SPOT02, t)
	if puppet_blimp:
		puppet_blimp.position = _eval_v3(POS_BLIMP, t)
		puppet_blimp.quaternion = _eval_quat(ROT_BLIMP, t)
	if flags_mat:
		flags_mat.set_shader_parameter("flags01_dx", _eval_1d(POS_FLAGS01_X, t) - 0.001)
		flags_mat.set_shader_parameter("flags02_dx", _eval_1d(POS_FLAGS02_X, t) - 0.001)

static func _find_seg(keys: Array, t: float) -> int:
	var n: int = keys.size()
	if t <= keys[0][0]:
		return 0
	if t >= keys[n - 1][0]:
		return n - 2
	var lo: int = 0
	var hi: int = n - 1
	while lo + 1 < hi:
		var mid: int = (lo + hi) >> 1
		if keys[mid][0] <= t:
			lo = mid
		else:
			hi = mid
	return lo

static func _eval_1d(keys: Array, t: float) -> float:
	var i: int = _find_seg(keys, t)
	var k0: Array = keys[i]
	var k1: Array = keys[i + 1]
	var dt: float = k1[0] - k0[0]
	if dt <= 0.000001:
		return k0[1]
	var u: float = clampf((t - k0[0]) / dt, 0.0, 1.0)
	var u2: float = u * u
	var u3: float = u2 * u
	var h00: float = 2.0 * u3 - 3.0 * u2 + 1.0
	var h10: float = u3 - 2.0 * u2 + u
	var h01: float = -2.0 * u3 + 3.0 * u2
	var h11: float = u3 - u2
	return h00 * float(k0[1]) + h10 * dt * float(k0[3]) + h01 * float(k1[1]) + h11 * dt * float(k1[2])

static func _eval_v3(keys: Array, t: float) -> Vector3:
	var i: int = _find_seg(keys, t)
	var k0: Array = keys[i]
	var k1: Array = keys[i + 1]
	var dt: float = k1[0] - k0[0]
	if dt <= 0.000001:
		return k0[1]
	var u: float = clampf((t - k0[0]) / dt, 0.0, 1.0)
	var u2: float = u * u
	var u3: float = u2 * u
	var h00: float = 2.0 * u3 - 3.0 * u2 + 1.0
	var h10: float = u3 - 2.0 * u2 + u
	var h01: float = -2.0 * u3 + 3.0 * u2
	var h11: float = u3 - u2
	var v0: Vector3 = k0[1]
	var v1: Vector3 = k1[1]
	var out0: Vector3 = k0[3]
	var in1: Vector3 = k1[2]
	return v0 * h00 + out0 * (h10 * dt) + v1 * h01 + in1 * (h11 * dt)

static func _eval_quat(keys: Array, t: float) -> Quaternion:
	var i: int = _find_seg(keys, t)
	var k0: Array = keys[i]
	var k1: Array = keys[i + 1]
	var dt: float = k1[0] - k0[0]
	if dt <= 0.000001:
		var q_init: Vector4 = k0[1]
		return Quaternion(q_init.x, q_init.y, q_init.z, q_init.w).normalized()
	var u: float = clampf((t - k0[0]) / dt, 0.0, 1.0)
	var u2: float = u * u
	var u3: float = u2 * u
	var h00: float = 2.0 * u3 - 3.0 * u2 + 1.0
	var h10: float = u3 - 2.0 * u2 + u
	var h01: float = -2.0 * u3 + 3.0 * u2
	var h11: float = u3 - u2
	var v0: Vector4 = k0[1]
	var v1: Vector4 = k1[1]
	var out0: Vector4 = k0[3]
	var in1: Vector4 = k1[2]
	var r: Vector4 = v0 * h00 + out0 * (h10 * dt) + v1 * h01 + in1 * (h11 * dt)
	return Quaternion(r.x, r.y, r.z, r.w).normalized()
